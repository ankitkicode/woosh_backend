{
  "info": {
    "name": "Woosh Backend API",
    "description": "Complete API documentation for Woosh Ride-Sharing Platform.\n\n## Base URL\n- **Local**: `http://localhost:5001/api/v1`\n- **Production**: `https://wooshride.in/api/v1`\n\n## Authentication\nMost endpoints require a Bearer token in the `Authorization` header.\n1. Call **Send OTP** to get an OTP on WhatsApp.\n2. Call **Verify OTP** to get `accessToken` + `refreshToken`.\n3. Use `accessToken` as Bearer token for protected endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "rideId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "riderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "childProfileId",
      "value": "",
      "type": "string"
    },
    {
      "key": "disputeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sosAlertId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "Authentication endpoints for OTP-based login/registration.",
      "item": [
        {
          "name": "1.1 Verify Gender (Face++ Selfie)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "selfie",
                  "type": "file",
                  "src": "",
                  "description": "(Required) Selfie image file. Must contain exactly one female face."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-gender",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-gender"
              ]
            },
            "description": "**Upload a selfie to verify gender via Face++ API.**"
          }
        },
        {
          "name": "1.2 Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OTP sent successfully', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9876543210\",\n  \"role\": \"passenger\",\n  \"action\": \"login\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "send-otp"
              ]
            },
            "description": "**Send a 6-digit OTP to the user's WhatsApp number.**"
          }
        },
        {
          "name": "1.3 Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json(); if (res.data && res.data.accessToken) { pm.collectionVariables.set('accessToken', res.data.accessToken); pm.collectionVariables.set('refreshToken', res.data.refreshToken); pm.collectionVariables.set('userId', res.data.user._id); } pm.test('OTP verified', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9876543210\",\n  \"otp\": \"123456\",\n  \"role\": \"passenger\",\n  \"deviceId\": \"postman-test-device\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "**Verify the OTP and receive access + refresh tokens.**"
          }
        },
        {
          "name": "1.4 Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json(); if (res.data) { pm.collectionVariables.set('accessToken', res.data.accessToken); pm.collectionVariables.set('refreshToken', res.data.refreshToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\",\n  \"deviceId\": \"postman-test-device\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh-token"
              ]
            },
            "description": "**Generate a new access token using the refresh token.**"
          }
        },
        {
          "name": "1.5 Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"postman-test-device\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "**Logout from current device.**"
          }
        }
      ]
    },
