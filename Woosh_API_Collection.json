{
  "info": {
    "name": "Woosh Platform Complete APIs",
    "description": "Comprehensive API documentation for Woosh Backend including Auth, Passenger, Rider, Ride Flow, Payments, and Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "6. Public & Config",
      "item": [
        {
          "name": "Get All Active Cities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cities"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "send-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9876543210\",\n  \"role\": \"PASSENGER\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9876543210\",\n  \"otp\": \"123456\",\n  \"role\": \"PASSENGER\",\n  \"deviceId\": \"device_123\",\n  \"os\": \"ios\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Passenger",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/passenger/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "passenger",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/passenger/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "passenger",
                "profile"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Rider",
      "item": [
        {
          "name": "Toggle Online Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rider/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rider",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isOnline\": true\n}"
            }
          }
        },
        {
          "name": "Add Bank Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rider/bank-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rider",
                "bank-accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountName\": \"Ankit Rider\",\n  \"accountNumber\": \"1234567890\",\n  \"ifscCode\": \"HDFC0001234\",\n  \"bankName\": \"HDFC Bank\"\n}"
            }
          }
        },
        {
          "name": "Request Payout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rider/wallet/payout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rider",
                "wallet",
                "payout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Ride & Payment Flow",
      "item": [
        {
          "name": "Estimate Ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/estimate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ride",
                "estimate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\"latitude\": 28.7041, \"longitude\": 77.1025},\n  \"drop\": {\"latitude\": 28.5355, \"longitude\": 77.3910}\n}"
            }
          }
        },
        {
          "name": "Request Ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ride",
                "request"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\"latitude\": 28.7, \"longitude\": 77.1, \"address\": \"Sector 1\"},\n  \"drop\": {\"latitude\": 28.5, \"longitude\": 77.3, \"address\": \"Sector 2\"},\n  \"paymentMethod\": \"CASH\"\n}"
            }
          }
        },
        {
          "name": "Accept Ride (Rider)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/{{rideId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ride",
                "{{rideId}}",
                "accept"
              ]
            }
          }
        },
        {
          "name": "Rider Arrived",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/{{rideId}}/arrived",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ride",
                "{{rideId}}",
                "arrived"
              ]
            }
          }
        },
        {
          "name": "Start Ride (Rider)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/{{rideId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ride",
                "{{rideId}}",
                "start"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"1234\"\n}"
            }
          }
        },
        {
          "name": "Complete Ride (Rider)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/{{rideId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ride",
                "{{rideId}}",
                "complete"
              ]
            }
          }
        },
        {
          "name": "Verify Digital Payment (Online Ride)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/{{rideId}}/verify-digital-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ride",
                "{{rideId}}",
                "verify-digital-payment"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpay_payment_id\": \"pay_xxxx\",\n  \"razorpay_signature\": \"sig_xxxx\"\n}"
            }
          }
        },
        {
          "name": "Confirm Payment (Cash Ride)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/{{rideId}}/confirm-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ride",
                "{{rideId}}",
                "confirm-payment"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin",
      "item": [
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/analytics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "analytics"
              ]
            }
          }
        },
        {
          "name": "Bulk Update Payouts",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/payouts/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payouts",
                "bulk"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payoutIds\": [\"id1\", \"id2\"],\n  \"status\": \"COMPLETED\",\n  \"transactionReference\": \"BULK_UTR_123\"\n}"
            }
          }
        }
      ]
    }
  ]
}