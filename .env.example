# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/woosh_db

# Security
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=7d

# 3rd Party Integrations

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Generic SMS Gateway (MSG91 / Fast2SMS)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=ride_tracking
META_WHATSAPP_OTP_TEMPLATE=otp_verification

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_JSON=

# Google Maps
GOOGLE_MAPS_API_KEY=

# KYC Provider (Aadhaar & Face Verification)
KYC_PROVIDER_URL=
KYC_API_KEY=

# CORS (comma-separated client URLs)
CLIENT_URLS=http://localhost:3000,http://localhost:5173

# SMS Gateway (Integrate when ready)
# MSG91_AUTH_KEY=your_msg91_key
# MSG91_SENDER_ID=WOOSHX

# Face++ API (Gender Verification)
FACEPP_API_KEY=
FACEPP_API_SECRET=
