    {
      "name": "7. Ride Booking & Zero-Commission Tips",
      "item": [
        {
          "name": "Get Supported Cities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities",
              "host": ["{{baseUrl}}"],
              "path": ["cities"]
            },
            "description": "Public endpoint returning list of active operating cities (e.g. Indore) with pricing rules."
          }
        },
        {
          "name": "Get Nearby Online Riders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/nearby-riders?latitude=22.7533&longitude=75.8937",
              "host": ["{{baseUrl}}"],
              "path": ["ride", "nearby-riders"],
              "query": [
                {
                  "key": "latitude",
                  "value": "22.7533"
                },
                {
                  "key": "longitude",
                  "value": "75.8937"
                }
              ]
            },
            "description": "Returns verified, online female riders within 5km radius to show on Passenger map."
          }
        },
        {
