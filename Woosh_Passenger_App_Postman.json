{
  "info": {
    "name": "Woosh Passenger App APIs",
    "description": "Complete Postman collection for Woosh Passenger App including Splash Face Scan (Gender Gatekeeper), Authentication, Unified Profile, Avatar Upload, Saved Places (Home/Work), Saved Payment Methods (UPI/Cards), Child Profiles, Ride Booking, Zero-Commission Tips, Passenger Wallet, SOS, and Support Tickets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "passengerPhone",
      "value": "9876543210",
      "type": "string"
    },
    {
      "key": "rideId",
      "value": "",
      "type": "string"
    },
    {
      "key": "savedPlaceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentMethodId",
      "value": "",
      "type": "string"
    },
    {
      "key": "childId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Splash Screen & Gender Verification",
      "item": [
        {
          "name": "Verify Gender (Selfie Gatekeeper)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-gender",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-gender"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "selfie",
                  "type": "file",
                  "description": "Female selfie image. If female, returns 200 OK allowing navigation to login. If male, returns 403 Forbidden blocking access.",
                  "src": []
                }
              ]
            },
            "description": "Called immediately after Splash Screen. Gatekeeper that allows only female passengers to access Login/Registration screens."
          }
        }
      ]
    },
    {
      "name": "2. Authentication & Login",
      "item": [
        {
          "name": "Send OTP (Passenger)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{passengerPhone}}\",\n  \"role\": \"passenger\",\n  \"action\": \"login\"\n}"
            },
            "description": "Send OTP for Passenger. 'action' can be 'login' or 'register'."
          }
        },
        {
          "name": "Verify OTP & Auto-Set Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    console.log('Passenger Token set successfully:', jsonData.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{passengerPhone}}\",\n  \"otp\": \"1234\",\n  \"role\": \"passenger\",\n  \"deviceId\": \"device_android_passenger_101\",\n  \"fcmToken\": \"fcm_token_passenger_example\",\n  \"platform\": \"android\"\n}"
            },
            "description": "Verifies OTP, automatically provisions PassengerProfile with isWomenVerified=true, and saves JWT token into collection variables."
          }
        },
        {
          "name": "Update FCM Token & Platform",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/fcm-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "fcm-token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"c_fresh_fcm_token_from_firebase\",\n  \"platform\": \"android\",\n  \"deviceId\": \"device_android_passenger_101\"\n}"
            },
            "description": "Called on app start or onTokenRefresh to register/update device FCM token and platform ('android' or 'ios')."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"YOUR_REFRESH_TOKEN_HERE\"\n}"
            }
          }
        },
        {
          "name": "Logout (Current Device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"device_android_passenger_101\"\n}"
            },
            "description": "Logs out passenger from current device and clears session/FCM tokens for this deviceId."
          }
        },
        {
          "name": "Logout All Devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout-all"]
            },
            "description": "Logs out passenger from all linked devices and clears all sessions."
          }
        },
        {
          "name": "Get Active Sessions (Linked Devices)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sessions"]
            },
            "description": "Get all active logged-in devices and sessions for current passenger."
          }
        },
        {
          "name": "Set MPIN (First Time Setup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/set-mpin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "set-mpin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mpin\": \"1234\",\n  \"confirmMpin\": \"1234\"\n}"
            },
            "description": "Logged in user sets a 4-6 digit MPIN for quick app lock/unlock."
          }
        },
        {
          "name": "Verify MPIN (Quick App Unlock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    console.log('Token refreshed via MPIN unlock!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-mpin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-mpin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mpin\": \"1234\",\n  \"phoneNumber\": \"{{passengerPhone}}\"\n}"
            },
            "description": "When passenger re-opens app, enters MPIN to instantly unlock app and receive refreshed token without entering OTP."
          }
        },
        {
          "name": "Change MPIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-mpin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-mpin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldMpin\": \"1234\",\n  \"newMpin\": \"5678\",\n  \"confirmNewMpin\": \"5678\"\n}"
            },
            "description": "User changes their MPIN by providing their old MPIN."
          }
        },
        {
          "name": "Forgot / Reset MPIN (with OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-mpin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-mpin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{passengerPhone}}\",\n  \"otp\": \"123456\",\n  \"newMpin\": \"9999\",\n  \"confirmNewMpin\": \"9999\"\n}"
            },
            "description": "Resets forgotten MPIN using mobile OTP verification."
          }
        }
      ]
    },
