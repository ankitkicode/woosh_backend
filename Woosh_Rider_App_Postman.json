{
  "info": {
    "name": "Woosh Rider App APIs",
    "description": "Complete Postman collection for Woosh Rider App including Auth, KYC, Status, Ride Lifecycle, Earnings, Monthly Statements, Dynamic PDF Export, Wallet, Cash Dues, Bank Accounts, and Support.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "rideId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bankAccountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Login",
      "item": [
        {
          "name": "Send OTP (Rider)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9876543210\",\n  \"role\": \"rider\",\n  \"action\": \"login\"\n}"
            },
            "description": "Send OTP for Rider. 'action' can be 'login' (checks if account exists) or 'register' (checks if not already registered)."
          }
        },
        {
          "name": "Verify OTP & Auto-Set Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    console.log('Rider Token set successfully:', jsonData.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9876543210\",\n  \"otp\": \"1234\",\n  \"role\": \"rider\",\n  \"deviceId\": \"device_android_99\",\n  \"fcmToken\": \"fcm_token_example_rider\",\n  \"platform\": \"android\"\n}"
            }
          }
        },
        {
          "name": "Update FCM Token & Platform",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/fcm-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "fcm-token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"c_fresh_fcm_token_from_firebase\",\n  \"platform\": \"android\",\n  \"deviceId\": \"device_android_99\"\n}"
            },
            "description": "Called by rider app on token refresh or app start to keep FCM push token and platform in sync."
          }
        },
        {
          "name": "Set MPIN (First Time Setup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/set-mpin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "set-mpin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mpin\": \"1234\",\n  \"confirmMpin\": \"1234\"\n}"
            },
            "description": "Logged-in rider sets a 4-6 digit MPIN for quick app lock/unlock."
          }
        },
        {
          "name": "Verify MPIN (Quick App Unlock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    console.log('Rider token refreshed via MPIN unlock!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-mpin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-mpin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mpin\": \"1234\",\n  \"phoneNumber\": \"9876543210\"\n}"
            },
            "description": "When rider re-opens app, enters MPIN to instantly unlock app and receive refreshed token without entering OTP."
          }
        },
        {
          "name": "Change MPIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-mpin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-mpin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldMpin\": \"1234\",\n  \"newMpin\": \"5678\",\n  \"confirmNewMpin\": \"5678\"\n}"
            },
            "description": "Rider changes their MPIN by providing their old MPIN."
          }
        },
        {
          "name": "Forgot / Reset MPIN (with OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-mpin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-mpin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9876543210\",\n  \"otp\": \"1234\",\n  \"newMpin\": \"9999\",\n  \"confirmNewMpin\": \"9999\"\n}"
            },
            "description": "Resets forgotten MPIN using mobile OTP verification."
          }
        },
        {
          "name": "Logout (Current Device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"device_android_99\"\n}"
            },
            "description": "Logs out rider from current device. Invalidates session and clears FCM push tokens for this device."
          }
        },
        {
          "name": "Logout All Devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout-all"]
            },
            "description": "Logs out rider from all logged-in devices and clears all sessions."
          }
        },
        {
          "name": "Get Active Sessions (Linked Devices)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sessions"]
            },
            "description": "Get all active logged-in devices and sessions for current rider."
          }
        }
      ]
    },
