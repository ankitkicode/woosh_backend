          "name": "Reject Ride",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/{{rideId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["ride", "{{rideId}}", "reject"]
            }
          }
        },
        {
          "name": "Rider Arrived at Pickup",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/{{rideId}}/arrived",
              "host": ["{{baseUrl}}"],
              "path": ["ride", "{{rideId}}", "arrived"]
            }
          }
        },
        {
          "name": "Start Ride (Verify Passenger OTP)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ride/{{rideId}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["ride", "{{rideId}}", "start"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"1234\"\n}"
            }
          }
        },
        {
